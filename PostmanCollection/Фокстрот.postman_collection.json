  "item": [
    {
      "name": "Логін динамічного для токену Шутов",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is valid JSON and contains token\", function () {\r",
              "    pm.response.to.be.json;\r",
              "    pm.expect(pm.response.json()).to.have.property(\"token\");\r",
              "    pm.collectionVariables.set(\"token_shutov\", pm.response.json().token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
